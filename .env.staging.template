# ──────────────────────────────────────────────
# ⚠ STAGING — Copiar a .env.staging e inyectar
#   credenciales reales en el servidor destino.
#   NUNCA subir este archivo con credenciales.
# ──────────────────────────────────────────────

# Django
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=CHANGE_ME_STAGING_SECRET_KEY_64CHARS_MIN
DJANGO_ALLOWED_HOSTS=staging.api.industrialprospecting.com,backend,localhost
DJANGO_LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=https://staging.app.industrialprospecting.com
CSRF_TRUSTED_ORIGINS=https://staging.app.industrialprospecting.com
DJANGO_SECURE_SSL=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=industrial_prospecting_staging
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://:CHANGE_ME_REDIS_PASS@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASS

# Celery
CELERY_RESULT_EXPIRES=600

# Cerebras AI
CEREBRAS_API_KEY=CHANGE_ME_CEREBRAS_KEY
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=cerebras/Llama-3.3-70B

# Apify (Google Maps Scraper)
APIFY_API_KEY=CHANGE_ME_APIFY_KEY
APIFY_ACTOR_ID=compass~crawler-google-places

# Snov.io (LinkedIn Contact Enrichment)
SNOV_CLIENT_ID=CHANGE_ME_SNOV_CLIENT_ID
SNOV_CLIENT_SECRET=CHANGE_ME_SNOV_SECRET

# Email (SMTP real)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=prospeccion@industrialprospecting.com
EMAIL_RATE_LIMIT=50
EMAIL_BATCH_PAUSE=1

# Gunicorn
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info

# URLs
BASE_URL=https://staging.api.industrialprospecting.com
NEXT_PUBLIC_API_BASE_URL=https://staging.api.industrialprospecting.com/api
