DB_ENGINE=django.db.backends.postgresql
DB_NAME=industrial_prospecting
DB_USER=postgres
DB_PASSWORD=camnbiar_esto_en_produccion
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://:redis@redis:6379/0
