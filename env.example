CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=cerebras/Llama-3.3-70B

# Gunicorn (production)
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
