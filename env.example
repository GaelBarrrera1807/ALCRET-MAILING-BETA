# ═══════════════════════════════════════════════════════════
#  Industrial Prospecting AI Platform — Variables de Entorno
#  Copia este archivo como .env (dev) o .env.prod (prod)
#  NUNCA subas secretos reales al repositorio
# ═══════════════════════════════════════════════════════════

# ── Django ────────────────────────────────────────────────
DJANGO_DEBUG=false                               # true en desarrollo
DJANGO_SECRET_KEY=cambiar-por-clave-segura-64-caracteres
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend  # separado por comas
DJANGO_LOG_LEVEL=INFO

# ── Seguridad (producción) ──────────────────────────────
# DJANGO_SECURE_SSL=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
# CORS_ALLOWED_ORIGINS=https://midominio.com
# CSRF_TRUSTED_ORIGINS=https://midominio.com

# ── Base de Datos ─────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=industrial_prospecting
DB_USER=postgres
DB_PASSWORD=cambiar-por-contrasena-segura
DB_HOST=db                                          # 'db' en Docker, 'localhost' en dev local
DB_PORT=5432

# ── Redis / Celery ──────────────────────────────────────
REDIS_URL=redis://:cambiar-redis-password@redis:6379/0
REDIS_PASSWORD=cambiar-redis-password

# ── Gunicorn ────────────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info

# ── Email (Amazon SES) ──────────────────────────────────
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com       # SES SMTP endpoint
EMAIL_PORT=587
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=prospeccion@tudominio.com
EMAIL_RATE_LIMIT=50
EMAIL_BATCH_PAUSE=1
BASE_URL=https://tudominio.com

# ── AWS S3 (para static/media en producción) ────────────
# USE_S3=true
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXX
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxx
# AWS_STORAGE_BUCKET_NAME=alcret-media-prod
# AWS_S3_REGION_NAME=us-east-1

# ── Cerebras (IA) ───────────────────────────────────────
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=cerebras/Llama-3.3-70B

# ── Scraping / Enriquecimiento ──────────────────────────
APIFY_API_KEY=
APIFY_ACTOR_ID=compass~crawler-google-places
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# ── Frontend ────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
